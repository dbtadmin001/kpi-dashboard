{"version": "0.1.1", "dialects": ["ANSI_SQL"], "semantic_model": [{"name": "semantic_model", "datasets": [{"name": "application_throughput", "source": "\"iceberg\".\"marketplace\".\"application_throughput\"", "primary_key": ["process"], "description": "How much regulatory work arrived and was completed each quarter, by process. The marketplace equivalent of a production-output measure: volume in, volume out, and the gap between them that becomes backlog.", "fields": [{"name": "application_throughput", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}}, {"name": "process", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}, "dimension": {"is_time": false}, "description": "Regulatory process: MA, CT or GMP"}, {"name": "arrival_date", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "arrival_date"}]}, "dimension": {"is_time": true}, "description": "Month the application arrived"}, {"name": "application_type", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "application_type"}]}, "dimension": {"is_time": false}, "description": "New, renewal, variation, amendment or inspection"}, {"name": "handling_route", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "handling_route"}]}, "dimension": {"is_time": false}, "description": "On-site or desk-based, domestic or foreign, alone or by reliance"}, {"name": "application_throughput_applications_received", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "applications_received"}]}, "description": "Applications that arrived"}, {"name": "application_throughput_applications_completed", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "applications_completed"}]}, "description": "Applications finished"}, {"name": "application_throughput_applications_open", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "applications_open"}]}, "description": "Still in progress"}, {"name": "application_throughput_applications_overdue", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "applications_overdue"}]}, "description": "Open and past their due date"}]}, {"name": "turnaround_performance", "source": "\"iceberg\".\"marketplace\".\"turnaround_performance\"", "primary_key": ["process"], "description": "How long work takes end to end, and how much of that time is genuinely spent working versus waiting in a queue. The split is the point: queue time is usually the cheaper half to remove.", "fields": [{"name": "turnaround_performance", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}}, {"name": "process", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}, "dimension": {"is_time": false}, "description": "Regulatory process"}, {"name": "activity", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "activity"}]}, "dimension": {"is_time": false}, "description": "Evaluation, inspection, decision, query response, CAPA or report"}, {"name": "arrival_date", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "arrival_date"}]}, "dimension": {"is_time": true}, "description": "Month the work arrived"}, {"name": "handling_route", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "handling_route"}]}, "dimension": {"is_time": false}, "description": "How the work was handled"}, {"name": "turnaround_performance_avg_turnaround_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "avg_turnaround_days"}]}, "description": "Mean calendar days from receipt to completion"}, {"name": "turnaround_performance_median_turnaround_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "median_turnaround_days"}]}, "description": "Median calendar days"}, {"name": "turnaround_performance_avg_working_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "avg_working_days"}]}, "description": "Days actively worked"}, {"name": "turnaround_performance_avg_waiting_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "avg_waiting_days"}]}, "description": "Days queueing"}, {"name": "turnaround_performance_pct_on_time", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "pct_on_time"}]}, "description": "Share completed on or before the due date"}]}, {"name": "delay_analysis", "source": "\"iceberg\".\"marketplace\".\"delay_analysis\"", "primary_key": ["process"], "description": "Where elapsed time is lost, stage by stage. The equivalent of a downtime analysis: it separates handling time from queue time so you can see which stage is the bottleneck and how much of the delay is recoverable.", "fields": [{"name": "delay_analysis", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}}, {"name": "process", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}, "dimension": {"is_time": false}, "description": "Regulatory process"}, {"name": "workflow_stage", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "workflow_stage"}]}, "dimension": {"is_time": false}, "description": "Stage in the regulatory workflow"}, {"name": "arrival_date", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "arrival_date"}]}, "dimension": {"is_time": true}, "description": "Month the work arrived"}, {"name": "delay_analysis_avg_elapsed_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "avg_elapsed_days"}]}, "description": "Mean days the stage took"}, {"name": "delay_analysis_avg_waiting_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "avg_waiting_days"}]}, "description": "Mean days queueing at this stage"}, {"name": "delay_analysis_pct_time_waiting", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "pct_time_waiting"}]}, "description": "Share of elapsed time spent waiting"}, {"name": "delay_analysis_times_performed", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "times_performed"}]}, "description": "How often the stage ran"}]}, {"name": "quality_metrics", "source": "\"iceberg\".\"marketplace\".\"quality_metrics\"", "primary_key": ["process"], "description": "Compliance outcomes from inspections and assessments: how many were found compliant, how many were not, and how that is trending. Restricted to analysts and above - compliance findings identify small cohorts of named facilities.", "fields": [{"name": "quality_metrics", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}}, {"name": "process", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}, "dimension": {"is_time": false}, "description": "Regulatory process"}, {"name": "activity", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "activity"}]}, "dimension": {"is_time": false}, "description": "Inspection, assessment or CAPA"}, {"name": "arrival_date", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "arrival_date"}]}, "dimension": {"is_time": true}, "description": "Month the work arrived"}, {"name": "handling_route", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "handling_route"}]}, "dimension": {"is_time": false}, "description": "How the work was handled"}, {"name": "quality_metrics_pct_compliant", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "pct_compliant"}]}, "description": "Share found compliant"}, {"name": "quality_metrics_compliant_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "compliant_count"}]}, "description": "Found compliant"}, {"name": "quality_metrics_non_compliant_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "non_compliant_count"}]}, "description": "Found non-compliant"}, {"name": "quality_metrics_assessments", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "assessments"}]}, "description": "Assessments with a recorded outcome"}]}, {"name": "indicator_performance", "source": "\"iceberg\".\"marketplace\".\"indicator_performance\"", "primary_key": ["process"], "description": "Every published indicator against its agreed target, by quarter. This is the certified source for the KPI dashboard - if a number appears on a slide, it should come from here.", "fields": [{"name": "indicator_performance", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}}, {"name": "process", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "process"}]}, "dimension": {"is_time": false}, "description": "Regulatory process"}, {"name": "indicator", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "indicator"}]}, "dimension": {"is_time": false}, "description": "Indicator identifier"}, {"name": "quarter_start", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "quarter_start"}]}, "dimension": {"is_time": true}, "description": "Reporting quarter"}, {"name": "target_status", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "target_status"}]}, "dimension": {"is_time": false}, "description": "Whether the target was met"}, {"name": "indicator_performance_indicator_value", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "indicator_value"}]}, "description": "Measured value"}, {"name": "indicator_performance_indicator_target", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "indicator_target"}]}, "description": "Agreed target"}]}], "metrics": [{"name": "application_throughput_applications_received", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(application_throughput.applications_received)"}]}, "description": "Applications that arrived"}, {"name": "application_throughput_applications_completed", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(application_throughput.applications_completed)"}]}, "description": "Applications finished"}, {"name": "application_throughput_applications_open", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(application_throughput.applications_open)"}]}, "description": "Still in progress"}, {"name": "application_throughput_applications_overdue", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(application_throughput.applications_overdue)"}]}, "description": "Open and past their due date"}, {"name": "turnaround_performance_avg_turnaround_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(turnaround_performance.avg_turnaround_days)"}]}, "description": "Mean calendar days from receipt to completion"}, {"name": "turnaround_performance_median_turnaround_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY turnaround_performance.median_turnaround_days)"}]}, "description": "Median calendar days"}, {"name": "turnaround_performance_avg_working_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(turnaround_performance.avg_working_days)"}]}, "description": "Days actively worked"}, {"name": "turnaround_performance_avg_waiting_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(turnaround_performance.avg_waiting_days)"}]}, "description": "Days queueing"}, {"name": "turnaround_performance_pct_on_time", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(turnaround_performance.pct_on_time)"}]}, "description": "Share completed on or before the due date"}, {"name": "delay_analysis_avg_elapsed_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(delay_analysis.avg_elapsed_days)"}]}, "description": "Mean days the stage took"}, {"name": "delay_analysis_avg_waiting_days", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(delay_analysis.avg_waiting_days)"}]}, "description": "Mean days queueing at this stage"}, {"name": "delay_analysis_pct_time_waiting", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(delay_analysis.pct_time_waiting)"}]}, "description": "Share of elapsed time spent waiting"}, {"name": "delay_analysis_times_performed", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(delay_analysis.times_performed)"}]}, "description": "How often the stage ran"}, {"name": "quality_metrics_pct_compliant", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(quality_metrics.pct_compliant)"}]}, "description": "Share found compliant"}, {"name": "quality_metrics_compliant_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(quality_metrics.compliant_count)"}]}, "description": "Found compliant"}, {"name": "quality_metrics_non_compliant_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(quality_metrics.non_compliant_count)"}]}, "description": "Found non-compliant"}, {"name": "quality_metrics_assessments", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(quality_metrics.assessments)"}]}, "description": "Assessments with a recorded outcome"}, {"name": "indicator_performance_indicator_value", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(indicator_performance.indicator_value)"}]}, "description": "Measured value"}, {"name": "indicator_performance_indicator_target", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "AVG(indicator_performance.indicator_target)"}]}, "description": "Agreed target"}]}]}