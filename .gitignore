# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local streaming runtime and credentials
.env
.venv/
__pycache__/
*.pyc
streaming/.runtime/
streaming/jars/
streaming/generated/

# Local service credentials - never commit
docs/ACCESS.md
.tools/
infra/.terraform/
infra/*.tfstate*
infra/terraform.tfvars
infra/generated/credentials.json
# The Trino OIDC client secret. infra/generated/data.json and authz.rego are
# policy, not secrets, so they stay tracked.
infra/generated/trino_oidc.json
# The deployment SSH key. Its public half goes on the VM, never the private one.
infra/generated/deploy_key
infra/generated/deploy_key.pub
infra/ansible/inventory/hosts.yml
infra/ansible/kubeconfig
infra/ansible/*.retry
marketplace/generated/
.delivery/
delivery/vendor/
delivery/environments/*.json
!delivery/environments/*.example.json
*.junit.xml

# Delivery artefacts. images.built.json holds the digests a deployment consumes
# and is produced by CI; .ci/ holds disposable per-run stacks and their secrets.
delivery/images.built.json
# Every credential in the stack. Belongs on the host, never in the repo.
**/secrets.env
delivery/vendor/
.ci/

# The catalog's own database. Rebuilt by `python -m catalog.cli collect`.
catalog/catalog.db*

# dbt run artifacts. Regenerated by every `dbt build`, so tracking them means a
# working tree that is never clean and a diff on every run that says nothing
# about the change. Nothing in this repository reads them - only dbt writes them.
marketplace/dbt/logs/
marketplace/dbt/target/
marketplace/dbt/dbt_packages/
