# Copy to .env (gitignored); use unique development credentials.
SHARED_NETWORK=atc-poc_pipeline_net
SQLSERVER_DATABASE=NDAStreaming
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=14333
SQLSERVER_USER=nda_simulator
SQLSERVER_PASSWORD=replace-me
MSSQL_SA_PASSWORD=replace-with-a-strong-development-password
DEBEZIUM_PASSWORD=replace-with-a-different-password
ERASURE_PASSWORD=replace-with-a-distinct-erasure-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-keycloak-admin-password
KEYCLOAK_URL=http://127.0.0.1:8180
OPA_URL=http://127.0.0.1:8182
AWS_ACCESS_KEY_ID=replace-with-nda-scoped-minio-key
AWS_SECRET_ACCESS_KEY=replace-with-nda-scoped-minio-secret
AWS_REGION=us-east-1
ICEBERG_REST_URI=http://iceberg-rest:8181
S3_ENDPOINT=http://minio:9000
CONNECT_PORT=8093
CONNECT_URL=http://127.0.0.1:8093
TRINO_HOST=127.0.0.1
TRINO_PORT=8090   # governed marketplace coordinator, not the shared 8083
TRINO_USER=nda_dashboard
TRINO_CATALOG=iceberg
NDA_API_KEY=replace-with-a-long-random-token
NDA_API_URL=http://127.0.0.1:8095
OPENMETADATA_URL=http://127.0.0.1:8585/api
OPENMETADATA_TOKEN=replace-with-ingestion-bot-token
# Versioned official images. No custom image builds.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU18-ubuntu-22.04
DEBEZIUM_IMAGE=quay.io/debezium/connect:3.0.8.Final
FLINK_IMAGE=flink:1.20.1-scala_2.12-java17
